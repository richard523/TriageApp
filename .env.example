# ============================================================
# TriageApp environment variables
# Copy this file to `.env` and fill in the values.
# Every variable is optional — the app runs in demo mode
# without them (in-memory storage, open approvals, local tickets).
# ============================================================

# --- Database (SQL Server / SQL Server Express) ---
# Default targets the SQLEXPRESS instance installed by the setup script.
DB_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=TriageApp;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# --- Microsoft auth (Entra ID app registration) ---
# Create an app registration in https://portal.azure.com (Entra ID -> App registrations).
# Redirect URI: https://localhost:5001/signin-microsoft
# Add the delegated profile (openid, email, profile) Microsoft Graph permissions.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Jira (Cloud; API token from https://id.atlassian.com/manage-profile/security/api-tokens) ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
# Optional: Jira workflow transition names applied on approve/reject
JIRA_APPROVE_TRANSITION=
JIRA_REJECT_TRANSITION=

# --- Quiz ---
# How many consecutive correct answers master a question (default 4)
QUIZ_MASTERY_THRESHOLD=4
