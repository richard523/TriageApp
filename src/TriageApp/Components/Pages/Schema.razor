@page "/schema"
@inject SchemaService SchemaSvc

<PageTitle>DB Schema — TriageApp</PageTitle>

<h1>Database schema</h1>
<p class="lead">Live schema of the TriageApp database, read from SQL Server <code>INFORMATION_SCHEMA</code>.</p>

@if (tables is null)
{
    <p class="muted">Loading…</p>
}
else if (tables.Count == 0)
{
    <div class="card">
        <p>No tables found. The database exists but has not been initialized — restart the app while SQL Server is reachable.</p>
    </div>
}
else
{
    <div class="schema-grid">
        @foreach (var table in tables)
        {
            <div class="card table-card">
                <h3 class="table-name">🗂️ @table.Name <span class="muted small">(@table.Columns.Count columns)</span></h3>
                <table class="table table-compact">
                    <thead>
                        <tr><th>Column</th><th>Type</th><th>Null</th><th>Key</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var col in table.Columns)
                        {
                            <tr>
                                <td>@col.Name</td>
                                <td class="muted">@col.Type</td>
                                <td>@(col.Nullable ? "✔" : "—")</td>
                                <td>
                                    @if (col.IsPrimaryKey)
                                    {
                                        <span class="key key-pk" title="Primary key">PK</span>
                                    }
                                    @if (col.ForeignKeyTarget is not null)
                                    {
                                        <span class="key key-fk" title="Foreign key → @col.ForeignKeyTarget">FK</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<SqlTable>? tables;

    protected override async Task OnInitializedAsync()
    {
        // null means SQL Server unreachable; the layout banner explains demo mode.
        tables = await SchemaSvc.GetTablesAsync();
    }
}
